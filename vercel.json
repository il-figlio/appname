{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/search.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "appname.py",
          "suggestions.py"
        ],
        "excludeFiles": [
          "node_modules/**",
          "src/**",
          "dist/**",
          "tests/**",
          ".github/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
