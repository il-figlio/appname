{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {"src": "api/search.py", "use": "@vercel/python", "config": {"includeFiles": ["appname.py"]}},
    {"src": "public/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/search", "dest": "/api/search.py"},
    {"src": "/", "dest": "/public/index.html"}
  ]
}
